      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const context = $('Validar y normalizar payload').item.json;\nconst phones = Array.isArray($json.data) ? $json.data : [];\nconst phone = phones.find((item) => String(item.id || '') === context.phone_number_id);\nconst graphError = $json.error?.message || (!phone ? 'El phone_number_id no pertenece al WABA o el token no tiene acceso.' : '');\nreturn [{ json: {\n  ...context,\n  meta_verified: Boolean(phone),\n  meta_error: graphError,\n  display_phone_number: phone?.display_phone_number || context.display_phone_number,\n  verified_name: phone?.verified_name || context.verified_name,\n  quality_rating: phone?.quality_rating || null,\n} }];"
      },
