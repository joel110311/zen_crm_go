      "name": "Webhook Embedded Signup",
      "webhookId": "whatsapp-login-code-crm"
    },
    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst text = (value) => typeof value === 'string' ? value.trim() : '';\nconst bool = (value) => value === true || value === 'true' || value === 1;\nconst result = {\n  event: text(input.event) || 'meta_embedded_signup_completed',\n  source: text(input.source) || 'zen_crm',\n  client: text(input.client),\n  app_id: text(input.app_id),\n  config_id: text(input.config_id),\n  solution_id: text(input.solution_id),\n  graph_api_version: text(input.graph_api_version) || 'v25.0',\n  business_id: text(input.business_id),\n  waba_id: text(input.waba_id),\n  phone_number_id: text(input.phone_number_id),\n  display_phone_number: text(input.display_phone_number),\n  verified_name: text(input.verified_name),\n  access_token: text(input.access_token),\n  callback_url: text(input.callback_url),\n  registration: input.registration ?? null,\n  subscription: input.subscription ?? null,\n  received_at: text(input.received_at) || new Date().toISOString(),\n};\nconst missing = ['client', 'waba_id', 'phone_number_id', 'access_token']\n  .filter((key) => !result[key]);\nconst callbackValid = !result.callback_url || /^https:\\/\\//i.test(result.callback_url);\nreturn [{ json: {\n  ...result,\n  valid: missing.length === 0 && callbackValid,\n  validation_error: missing.length ? 'Faltan campos: ' + missing.join(', ') : (!callbackValid ? 'callback_url debe usar HTTPS' : ''),\n  suscripcion_webhooks: bool(input.subscription?.subscribed ?? input.suscripcion_webhooks),\n} }];"
      },
